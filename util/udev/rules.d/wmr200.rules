# Oregon Scientific WMR200/WMR200A: service access and no USB autosuspend.
# The service account must be a member of the "weewx" group.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fde", ATTR{idProduct}=="ca01", GROUP="weewx", MODE="0660", TEST=="power/control", ATTR{power/control}="on"
